Buzz, buzz, make_buzz ::
    struct {
        i: int;
        b: bool;
    },

    Buzz{0, 1},

    (i: int, b: bool) -> Buzz {
        ret: Buzz;
        ret.i, ret.b = i, b;
        //return ret;
        return Buzz{i, b};
    }

